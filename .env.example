# Vyom — Environment Variables Reference
#
# Copy this file to `.env.local` and fill in the values.
# Never commit real secrets to source control.
# All VITE_* variables are bundled into the client — do NOT put server secrets here.

# ─── Analytics ────────────────────────────────────────────────────────────────
# Provider: 'ga4' | 'plausible' | 'none'
VITE_ANALYTICS_PROVIDER=none

# Google Analytics 4 Measurement ID (only used when VITE_ANALYTICS_PROVIDER=ga4)
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Plausible data domain (only used when VITE_ANALYTICS_PROVIDER=plausible)
VITE_PLAUSIBLE_DOMAIN=Vyom.ai

# ─── Integrations ─────────────────────────────────────────────────────────────
# Calendar scheduling URL (Calendly or equivalent)
VITE_CALENDAR_URL=https://calendly.com/Vyom/consultation

# LinkedIn company page URL
VITE_LINKEDIN_URL=https://linkedin.com/company/Vyomi

# ─── Deployment ───────────────────────────────────────────────────────────────
# Public site URL (used in SEO and sitemap — no trailing slash)
VITE_PUBLIC_URL=https://Vyom.ai
